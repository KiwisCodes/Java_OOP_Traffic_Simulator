  <tag k="check_date" v="2025-03-31"/>
  <tag k="description" v="Am 6. Februar 1996 stürzte die Boeing 757-225 (Kennung TC-GEN) der Birgen Air (ALW-301) kurz nach dem Start in Puerto Plata (POP) in den Atlantik. Alle 189 Insassen starben, »für 116 Menschen wurde das Meer die letzte Ruhestätte«."/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Am 6. Februar 1996 stürzte auf dem Flug nach Deutschland vor der Küste der Dominikanischen Republik ein Flugzeug ins Meer. Bei diesem Unglück gab es keine Überlebenden und nur 73 Opfer konnten geborgen werden."/>
  <tag k="material" v="stone"/>
  <tag k="memorial" v="stele"/>
 </node>
