 <node id="7373597305" visible="true" version="5" changeset="158174234" timestamp="2024-10-21T14:54:55Z" user="mneko" uid="158194" lat="50.1265872" lon="8.6835049">
  <tag k="description:en" v="ANNO DOMINI MDLII &quot;When in 1552 on March 17th some princes besieged the neighboring city with a heavy siege, my father's house was burned and rebuilt by me, Kraft Stalburg, in memory of it.&quot;"/>
  <tag k="heritage" v="4"/>
  <tag k="heritage:operator" v="LfDH"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="ANNO DOMINI MDLII „Als im Jahre 1552 am 17. März einige Fürsten die benachbarte Stadt mit schwerer Belagerung bedrängten, wurde mein väterliches Haus verbrannt und durch mich, Kraft Stalburg, in Erinnerung dessen von Neuem wieder erbaut.“"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Inschrifttafel von Kraft Stalburg"/>
